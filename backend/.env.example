# Copiá este archivo como backend/.env y completá los valores.
# backend/.env está en .gitignore: nunca se sube al repositorio.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Solo para scripts/crear_usuarios_prueba.py (no usar en producción)
# CLAVE_PRUEBA=una-clave-de-prueba-larga

# Cloudinary (se usa al guardar los ensayos, más adelante)
CLOUDINARY_CLOUD_NAME=tu-nube
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# CORS para despliegue: URL(s) del frontend separadas por coma (sin barra final)
# CORS_ORIGINS=https://tu-app.vercel.app
