@startuml
title LIMS-BioPuna - Modelo de datos (estado actual)
hide circle
skinparam linetype ortho
skinparam classAttributeIconSize 0

entity "auth.users (Supabase Auth)" as auth_users {
  * id : uuid <<PK>>
  --
  email
  raw_user_meta_data
  ...
}

entity "investigador" as investigador {
  * id_investigador : uuid <<PK, FK auth.users.id>>
  --
  * nombre : text
  * email : text <<unique>>
  rol_catedra : text
  * rol_sistema : text <<admin|investigador|lectura, default lectura>>
  * creado_en : timestamptz
}

entity "provincia" as provincia {
  * id_provincia : smallint <<PK, identity>>
  --
  * nombre : text <<unique>>
}

entity "departamento" as departamento {
  * id_departamento : smallint <<PK, identity>>
  --
  * id_provincia : smallint <<FK provincia>>
  * nombre : text
  --
  <<unique (id_provincia, nombre)>>
}

entity "campana_territorio" as campana {
  * id_campana : bigint <<PK, identity>>
  --
  localidad_puna : text <<legible/compatibilidad, nullable>>
  * fecha_salida : date
  * convenio_inta : boolean <<default false>>
  observaciones : text
  id_departamento : smallint <<FK departamento, nullable>>
  localidad_detalle : text
  creado_por : uuid <<FK investigador, default auth.uid()>>
  * creado_en : timestamptz <<default now()>>
}

entity "muestra_animal" as muestra {
  * id_muestra : bigint <<PK, identity>>
  --
  * id_campana : bigint <<FK campana_territorio>>
  * codigo_animal : text
  * especie : text <<Llama|Vicuña|Oveja|Caballo>>
  * fecha_hora_extraccion : timestamptz
  creado_por : uuid <<FK investigador, default auth.uid()>>
  * creado_en : timestamptz <<default now()>>
  --
  <<unique (id_campana, codigo_animal)>>
}

entity "ensayo_electroforetico" as ensayo {
  * id_ensayo : bigint <<PK, identity>>
  --
  * id_muestra : bigint <<FK muestra_animal>>
  * id_investigador : uuid <<FK investigador>>
  * fecha_corrida : timestamptz <<default now()>>
  * proteinas_totales_g_dl : numeric(4,2) <<(0,20]>>
  url_imagen_tira : text <<URL Cloudinary, nullable>>
  * metodo_lectura : text <<digital_opencv|espectrofotometro, default digital_opencv>>
  relacion_ag : double precision <<nullable, derivada>>
  creado_por : uuid <<FK investigador, default auth.uid()>>
  * creado_en : timestamptz <<default now()>>
}

entity "fraccion_proteica" as fraccion {
  * id_fraccion : bigint <<PK, identity>>
  --
  * id_ensayo : bigint <<FK ensayo_electroforetico ON DELETE CASCADE>>
  * nombre_fraccion : text <<clasico o 'Fracción 1..20'>>
  * area_integrada : numeric
  * porcentaje_relativo : numeric(5,2) <<[0,100]>>
  * concentracion_g_dl : numeric(5,2)
  --
  <<unique (id_ensayo, nombre_fraccion)>>
}

entity "muestra_con_estado (VIEW)" as vista_muestra <<view>> {
  * id_muestra : bigint
  --
  id_campana : bigint
  codigo_animal : text
  especie : text
  fecha_hora_extraccion : timestamptz
  primera_corrida : timestamptz
  horas_transcurridas : numeric
  estado_48h : text <<procesada|verde|amarillo|rojo>>
  creado_por : uuid
  creado_en : timestamptz
}

auth_users ||--|| investigador : perfil
provincia ||--o{ departamento
departamento |o--o{ campana : ubicación
investigador |o--o{ campana : creado_por
campana ||--o{ muestra
investigador |o--o{ muestra : creado_por
muestra ||--o{ ensayo
investigador ||--o{ ensayo : id_investigador
investigador |o--o{ ensayo : creado_por
ensayo ||--o{ fraccion
muestra ||..|| vista_muestra : base

note right of ensayo
  Trigger (009): fecha_corrida >= fecha_hora_extraccion de la muestra.
  relacion_ag calculada al guardar (006); puede recalcularse al listar si falta.
  Borrado admin (API): elimina ensayo+fracciones (cascade) y limpia imagen Cloudinary (best effort).
end note

note bottom of fraccion
  CHECK nombre_fraccion (008):
  clasicos {Albumina,Alfa1,Alfa2,Beta,Beta1,Beta2,Gamma}
  o patron ^Fracción (1..20)$.
  Un ensayo = una sola tira/perfil (validado en backend).
end note

note bottom of muestra
  url_foto_campo eliminado (011).
  estado_48h se calcula en vista muestra_con_estado
  según primera corrida y ventana 48 h.
end note

@enduml
